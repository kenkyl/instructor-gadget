  "flows": [
    {
      "id": "course-probe",
      "name": "Generate diagnostic questions",
      "description": "After a learner creates a course, the API asks the diagnose skill for probe questions and stores them. Diagnose is never cached.",
      "steps": [
        {
          "from": "learner",
          "to": "web",
          "msg": "Submit intake; request diagnostic questions",
          "kind": "call"
        },
        {
          "from": "web",
          "to": "api",
          "msg": "POST /api/courses/{id}/probe with sid cookie",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "redis",
          "msg": "HGETALL sess:{sid}",
          "kind": "call"
        },
        {
          "from": "redis",
          "to": "api",
          "msg": "The session's user",
          "kind": "return"
        },
        {
          "from": "api",
          "to": "postgres",
          "msg": "Load the course; check the user owns it",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "agent",
          "msg": "Run diagnose.probe with the intake",
          "kind": "call"
        },
        {
          "from": "agent",
          "to": "anthropic",
          "msg": "Structured-output request",
          "kind": "call"
        },
        {
          "from": "anthropic",
          "to": "agent",
          "msg": "JSON reply; Pydantic-validated, one retry",
          "kind": "return"
        },
        {
          "from": "agent",
          "to": "api",
          "msg": "Validated ProbeOutput",
          "kind": "return"
        },
        {
          "from": "api",
          "to": "postgres",
          "msg": "Save the assessment; log the call",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "web",
          "msg": "Course detail with the questions",
          "kind": "return"
        }
      ]
    },
    {
      "id": "open-lesson",
      "name": "Open a concept's lesson",
      "description": "The unlock gate runs first. A stored lesson opens instantly; otherwise the lesson is served from the exact or semantic cache, or generated and streamed.",
      "steps": [
        {
          "from": "learner",
          "to": "web",
          "msg": "Open a concept (lesson stream)",
          "kind": "call"
        },
        {
          "from": "web",
          "to": "api",
          "msg": "POST .../lesson (SSE) via the proxy",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "postgres",
          "msg": "Load plan, progress, any stored lesson",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "pedagogy",
          "msg": "Unlocked? Prerequisites at least solid",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "agent",
          "msg": "Run teach-concept.teach",
          "kind": "call"
        },
        {
          "from": "agent",
          "to": "cache",
          "msg": "Exact key, then semantic match",
          "kind": "call"
        },
        {
          "from": "cache",
          "to": "redis",
          "msg": "JSON.GET, then vector search with tag filter",
          "kind": "call"
        },
        {
          "from": "agent",
          "to": "anthropic",
          "msg": "On a miss: stream structured output",
          "kind": "call"
        },
        {
          "from": "agent",
          "to": "cache",
          "msg": "Store the lesson in both tiers",
          "kind": "call"
        },
        {
          "from": "agent",
          "to": "postgres",
          "msg": "llm_calls row: tokens, latency, cache result",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "web",
          "msg": "SSE field deltas, then done",
          "kind": "return"
        }
      ]
    },
    {
      "id": "submit-quiz",
      "name": "Grade a quiz and adapt the plan",
      "description": "Grading is never cached. Code scores, sets mastery and the review date, and decides whether the plan changes; a skill only writes the words.",
      "steps": [
        {
          "from": "learner",
          "to": "web",
          "msg": "Submit quiz answers",
          "kind": "call"
        },
        {
          "from": "web",
          "to": "api",
          "msg": "POST .../quiz-attempts/{id}/submit",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "pedagogy",
          "msg": "Score the multiple-choice answers",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "agent",
          "msg": "Run grade on the short answer",
          "kind": "call"
        },
        {
          "from": "agent",
          "to": "anthropic",
          "msg": "Structured-output request",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "pedagogy",
          "msg": "Combine, mastery, band, FSRS date, rule",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "agent",
          "msg": "If re-planning: remediate.explain_change",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "postgres",
          "msg": "Progress, misconception, plan version N+1",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "redis",
          "msg": "DEL dash:{user_id}",
          "kind": "call"
        },
        {
          "from": "api",
          "to": "web",
          "msg": "Score, feedback, band, what happens next",
          "kind": "return"
        }
      ]
    }
  ],
