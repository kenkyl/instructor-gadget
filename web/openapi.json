{
  "openapi": "3.1.0",
  "info": {
    "title": "Instructor API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/seeded": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "List Seeded Users",
        "description": "Phase 1 login picker. Replaced by Google sign-in in P2.",
        "operationId": "list_seeded_users_api_users_seeded_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SeededUser"
                  },
                  "type": "array",
                  "title": "Response List Seeded Users Api Users Seeded Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "operationId": "logout_api_auth_logout_post",
        "parameters": [
          {
            "name": "sid",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Me",
        "operationId": "me_api_me_get",
        "parameters": [
          {
            "name": "sid",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Dashboard",
        "operationId": "dashboard_api_dashboard_get",
        "parameters": [
          {
            "name": "sid",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/skills": {
      "get": {
        "tags": [
          "skills"
        ],
        "summary": "List Skills",
        "operationId": "list_skills_api_skills_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SkillInfo"
                  },
                  "type": "array",
                  "title": "Response List Skills Api Skills Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CallInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "cache": {
            "type": "string",
            "enum": [
              "exact",
              "semantic",
              "never"
            ],
            "title": "Cache"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          }
        },
        "type": "object",
        "required": [
          "name",
          "cache",
          "stream",
          "prompt_version"
        ],
        "title": "CallInfo"
      },
      "CurrentUser": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name"
        ],
        "title": "CurrentUser"
      },
      "DashboardCourse": {
        "properties": {
          "enrollment_id": {
            "type": "string",
            "format": "uuid",
            "title": "Enrollment Id"
          },
          "course_id": {
            "type": "string",
            "format": "uuid",
            "title": "Course Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "scope": {
            "type": "string",
            "enum": [
              "personal",
              "org"
            ],
            "title": "Scope"
          },
          "org_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "complete"
            ],
            "title": "Status"
          },
          "concepts_total": {
            "type": "integer",
            "title": "Concepts Total"
          },
          "concepts_complete": {
            "type": "integer",
            "title": "Concepts Complete"
          },
          "due_count": {
            "type": "integer",
            "title": "Due Count"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "enrollment_id",
          "course_id",
          "title",
          "scope",
          "org_name",
          "status",
          "concepts_total",
          "concepts_complete",
          "due_count",
          "completed_at"
        ],
        "title": "DashboardCourse"
      },
      "DashboardResponse": {
        "properties": {
          "user": {
            "$ref": "#/components/schemas/CurrentUser"
          },
          "courses": {
            "items": {
              "$ref": "#/components/schemas/DashboardCourse"
            },
            "type": "array",
            "title": "Courses"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "served_from": {
            "type": "string",
            "enum": [
              "cache",
              "db"
            ],
            "title": "Served From"
          }
        },
        "type": "object",
        "required": [
          "user",
          "courses",
          "generated_at",
          "served_from"
        ],
        "title": "DashboardResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status"
          },
          "postgres": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Postgres"
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Redis"
          },
          "redis_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redis Version"
          },
          "query_engine": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Query Engine"
          },
          "postgres_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postgres Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "postgres",
          "redis",
          "redis_version",
          "query_engine",
          "postgres_version"
        ],
        "title": "HealthResponse"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "type": "object",
        "required": [
          "username"
        ],
        "title": "LoginRequest"
      },
      "SeededUser": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "username",
          "display_name"
        ],
        "title": "SeededUser"
      },
      "SkillInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "modifier": {
            "type": "boolean",
            "title": "Modifier"
          },
          "calls": {
            "items": {
              "$ref": "#/components/schemas/CallInfo"
            },
            "type": "array",
            "title": "Calls"
          }
        },
        "type": "object",
        "required": [
          "name",
          "version",
          "description",
          "modifier",
          "calls"
        ],
        "title": "SkillInfo"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
