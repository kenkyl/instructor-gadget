  "components": {
    "schemas": {
      "AnswersIn": {
        "properties": {
          "answers": {
            "additionalProperties": {
              "type": "string",
              "maxLength": 4000
            },
            "type": "object",
            "title": "Answers"
          }
        },
        "type": "object",
        "required": [
          "answers"
        ],
        "title": "AnswersIn",
        "description": "{question_id: answer}. Blank is allowed and counts as \"I don't know\" (assess.md)."
      },
      "AssessOutput": {
        "properties": {
          "claimed_level": {
            "type": "string",
            "enum": [
              "novice",
              "intermediate",
              "strong",
              "expert"
            ],
            "title": "Claimed Level"
          },
          "assessed_level": {
            "type": "string",
            "enum": [
              "novice",
              "intermediate",
              "strong",
              "expert"
            ],
            "title": "Assessed Level"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "minItems": 1,
            "title": "Evidence"
          },
          "gaps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Gaps"
          },
          "adjustment_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Adjustment Message",
            "description": "Required when assessed_level != claimed_level; else null"
          }
        },
        "type": "object",
        "required": [
          "claimed_level",
          "assessed_level",
          "confidence",
          "evidence",
          "gaps"
        ],
        "title": "AssessOutput"
      },
      "CallInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "cache": {
            "type": "string",
            "enum": [
              "exact",
              "semantic",
              "never"
            ],
            "title": "Cache"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          }
        },
        "type": "object",
        "required": [
          "name",
          "cache",
          "stream",
          "prompt_version"
        ],
        "title": "CallInfo"
      },
      "Concept": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "title": "Id",
            "description": "Short kebab-case slug"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "title": "Title"
          },
          "mastery_statement": {
            "type": "string",
            "title": "Mastery Statement",
            "description": "Observable outcome, starting \"You can \u2026\""
          },
          "objective_level": {
            "type": "string",
            "enum": [
              "remember",
              "understand",
              "apply",
              "analyze",
              "evaluate",
              "create"
            ],
            "title": "Objective Level",
            "description": "Bloom level of the mastery statement's verb"
          },
          "prereqs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Prereqs",
            "description": "Ids of direct prerequisites in this map"
          },
          "est_minutes": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 5.0,
            "title": "Est Minutes",
            "description": "Lesson + quiz time"
          },
          "concept_type": {
            "type": "string",
            "enum": [
              "algorithm",
              "systems",
              "math",
              "syntax",
              "api",
              "conceptual"
            ],
            "title": "Concept Type"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "mastery_statement",
          "objective_level",
          "prereqs",
          "est_minutes",
          "concept_type"
        ],
        "title": "Concept"
      },
      "ConceptMap": {
        "properties": {
          "concepts": {
            "items": {
              "$ref": "#/components/schemas/Concept"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Concepts"
          },
          "sequence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sequence",
            "description": "Every concept id once, each after its prereqs"
          },
          "sequence_rationale": {
            "type": "string",
            "title": "Sequence Rationale",
            "description": "Why this order, written to the learner"
          }
        },
        "type": "object",
        "required": [
          "concepts",
          "sequence",
          "sequence_rationale"
        ],
        "title": "ConceptMap",
        "description": "Stored in courses.template_plan and plan_versions.plan. These graph rules hold for\nevery stored map, including after the learner cuts concepts (PC1.4)."
      },
      "CourseConfig": {
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 300,
            "minLength": 2,
            "title": "Topic"
          },
          "target_hours": {
            "type": "number",
            "maximum": 40.0,
            "minimum": 0.5,
            "title": "Target Hours",
            "default": 3
          },
          "target_level": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced",
              "expert"
            ],
            "title": "Target Level",
            "default": "intermediate"
          },
          "self_level": {
            "type": "string",
            "enum": [
              "novice",
              "intermediate",
              "strong",
              "expert"
            ],
            "title": "Self Level",
            "default": "intermediate"
          },
          "formats": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Formats"
          }
        },
        "type": "object",
        "required": [
          "topic"
        ],
        "title": "CourseConfig",
        "description": "Stored in courses.config (JSONB). New knobs = new fields with defaults, no migration."
      },
      "CourseDetail": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "$ref": "#/components/schemas/CourseStatus"
          },
          "config": {
            "$ref": "#/components/schemas/CourseConfig"
          },
          "mission": {
            "$ref": "#/components/schemas/Mission"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/ProbeQuestionView"
            },
            "type": "array",
            "title": "Questions"
          },
          "answers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Answers"
          },
          "assessment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AssessOutput"
              },
              {
                "type": "null"
              }
            ]
          },
          "concept_map": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConceptMap"
              },
              {
                "type": "null"
              }
            ]
          },
          "enrollment_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enrollment Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "config",
          "mission"
        ],
        "title": "CourseDetail"
      },
      "CourseIntake": {
        "properties": {
          "config": {
            "$ref": "#/components/schemas/CourseConfig"
          },
          "mission": {
            "$ref": "#/components/schemas/Mission"
          }
        },
        "type": "object",
        "required": [
          "config",
          "mission"
        ],
        "title": "CourseIntake",
        "description": "The intake form (spec \u00a74.1). Defaults live in CourseConfig/Mission and the form."
      },
      "CourseStatus": {
        "type": "string",
        "enum": [
          "draft",
          "probed",
          "assessed",
          "mapped",
          "active"
        ],
        "title": "CourseStatus"
      },
      "CurrentUser": {
        "properties": {
          "id": {
            "type": "string",
