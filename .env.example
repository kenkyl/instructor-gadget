# Copy to .env and fill in. Never commit .env.

# Anthropic (the only external dependency)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT_SECONDS=90

# Data stores (docker compose)
DATABASE_URL=postgresql+psycopg://instructor:instructor@localhost:5432/instructor
REDIS_URL=redis://localhost:6379/0

# Sessions
SESSION_TTL_SECONDS=28800

# Semantic cache (tuned by the cache eval at CP3)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.12
